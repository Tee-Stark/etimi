{
  "name": "timmy-omolana-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm content:routes && next dev",
    "dev:preview": "pnpm content:routes && CONTENT_PREVIEW=1 next dev",
    "build": "pnpm content:validate && pnpm content:check-banned && pnpm content:routes && next build && pnpm content:check-output",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm content:routes && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:check-banned": "tsx scripts/check-banned-content.ts",
    "content:check-output": "tsx scripts/check-build-output.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "content:routes": "tsx scripts/generate-route-manifest.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "github-slugger": "^2.0.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9"
  }
}
